{
	"name": "todotxt-md",
	"version": "0.1.0",
	"description": "Clean, keyboard-driven, emoji-free todo.txt ergonomics over Markdown checkboxes in Obsidian.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev:copy": "node scripts/copy-to-vault.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . && prettier --check ."
	},
	"keywords": [
		"obsidian",
		"todo.txt",
		"tasks"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.9.0",
		"@types/node": "^20.14.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.9.0",
		"eslint-config-prettier": "^9.1.0",
		"obsidian": "latest",
		"prettier": "^3.3.3",
		"tslib": "2.6.3",
		"typescript": "^5.5.4",
		"vitest": "^3.0.0"
	}
}
